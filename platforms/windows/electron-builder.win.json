{
  "appId": "com.guzi.scholar",
  "productName": "谷子学术",
  "copyright": "Guzi Scholar",
  "electronVersion": "43.2.0",
  "directories": {
    "app": ".",
    "output": "../../platforms/windows/dist"
  },
  "asar": false,
  "files": [
    "electron/**/*",
    "web/**/*",
    "*.py",
    "config.example.json",
    "!data{,/**/*}",
    "!tests{,/**/*}",
    "!developer.tokens.json",
    "!config.local.json",
    "!**/.env*",
    "!**/*.pem",
    "!**/*.key",
    "!**/__pycache__{,/**/*}",
    "!**/*.py[cod]",
    "!**/.DS_Store",
    "mcp/bridge.cjs",
    "mcp/bridge.cjs.LEGAL.txt",
    "plugin_templates/**/*"
  ],
  "extraMetadata": {
    "name": "guzi-scholar",
    "main": "electron/main.cjs"
  },
  "win": {
    "icon": "electron/assets/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64"
        ]
      }
    ],
    "executableName": "Guzi-Scholar"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "谷子学术",
    "artifactName": "Guzi-Scholar-${version}-windows-${arch}-setup.${ext}"
  },
  "artifactName": "Guzi-Scholar-${version}-windows-${arch}.${ext}",
  "compression": "maximum",
  "npmRebuild": false,
  "extraResources": [
    {
      "from": "build/windows-runtime/my-scholar-server",
      "to": "python-server"
    },
    {
      "from": "build/windows-runtime/java",
      "to": "java"
    },
    {
      "from": "build/windows-runtime/opendataloader-pdf-cli-0.0.0.jar",
      "to": "toolchain/opendataloader-pdf-cli-0.0.0.jar"
    },
    {
      "from": "build/windows-runtime/pandoc",
      "to": "toolchain/pandoc"
    },
    {
      "from": "build/windows-runtime/pdf-renderer",
      "to": "toolchain/pdf-renderer"
    },
    {
      "from": "../../LICENSE",
      "to": "licenses/Guzi-Scholar-LICENSE"
    },
    {
      "from": "../../NOTICE.md",
      "to": "licenses/Guzi-Scholar-NOTICE.md"
    },
    {
      "from": "build/windows-runtime/licenses",
      "to": "licenses/runtime"
    },
    {
      "from": "build/windows-runtime/licenses/opendataloader-pdf",
      "to": "licenses/opendataloader-pdf"
    },
    {
      "from": "build/windows-runtime/licenses/pandoc",
      "to": "licenses/pandoc"
    }
  ]
}
