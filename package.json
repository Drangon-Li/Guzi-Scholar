{
  "name": "guzi-scholar",
  "version": "0.6.6",
  "private": true,
  "license": "Apache-2.0",
  "description": "Open-source cross-platform academic PDF reader",
  "author": "Guzi Scholar",
  "scripts": {
    "desktop:dev": "npm --prefix apps/desktop run dev",
    "desktop:check": "npm --prefix apps/desktop run check",
    "desktop:check:syntax": "npm --prefix apps/desktop run check:syntax",
    "build:mac": "npm --prefix apps/desktop run dist:mac:internal",
    "build:windows": "node platforms/windows/build-windows.cjs dist",
    "pack:windows": "node platforms/windows/build-windows.cjs dir",
    "check:windows": "node platforms/windows/build-windows.cjs check && npm --prefix apps/desktop run test:windows",
    "verify:windows": "node apps/desktop/tests/windows_package_test.js platforms/windows/dist/win-unpacked",
    "verify:windows:artifacts": "node apps/desktop/tests/windows_package_test.js platforms/windows/dist/win-unpacked --artifacts",
    "sync": "cap sync",
    "android:build": "cd android && ./gradlew assembleDebug",
    "android:install": "cd android && ./gradlew installDebug",
    "ios:open": "cap open ios",
    "desktop:dev:plugins": "npm --prefix apps/desktop run dev:plugins"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
