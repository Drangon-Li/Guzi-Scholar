#!/usr/bin/env bash
set -Eeuo pipefail

readonly DB_PATH=${GUZI_SCHOLAR_BACKUP_DB_PATH:-/home/guzi/data/guzi-scholar/account/users.db}
readonly BACKUP_DIR=${GUZI_SCHOLAR_BACKUP_DIR:-/home/guzi/backups/guzi-scholar/account}
readonly LOCK_PATH=${GUZI_SCHOLAR_BACKUP_LOCK_PATH:-/run/guzi-scholar-account-backup/backup.lock}
readonly DB_VERIFY=${GUZI_SCHOLAR_BACKUP_DB_VERIFY:-/home/guzi/services/guzi-scholar/sbin/guzi-scholar-db-verify}
readonly KEEP_DAYS=30
readonly KEEP_MIN=14

install -d -m 0700 "$BACKUP_DIR"
exec 9>"$LOCK_PATH"
if ! flock -n 9; then
  echo "[backup] another backup is already running"
  exit 0
fi

if [[ ! -f "$DB_PATH" ]]; then
  echo "[backup] database not found: $DB_PATH" >&2
  exit 66
fi

STAMP=$(date -u +%Y%m%dT%H%M%SZ)
FINAL="$BACKUP_DIR/users-$STAMP.sqlite3"
TEMP="$BACKUP_DIR/.users-$STAMP.$$.tmp"
CHECKSUM_TEMP="$BACKUP_DIR/.users-$STAMP.$$.sha256.tmp"

cleanup() {
  [[ ! -e "$TEMP" ]] || unlink -- "$TEMP"
  [[ ! -e "$CHECKSUM_TEMP" ]] || unlink -- "$CHECKSUM_TEMP"
}
trap cleanup EXIT

python3 - "$DB_PATH" "$TEMP" <<'PY'
import pathlib
import sqlite3
import sys
import urllib.parse

source_path = pathlib.Path(sys.argv[1]).resolve(strict=True)
target_path = pathlib.Path(sys.argv[2])
source_uri = "file:" + urllib.parse.quote(str(source_path)) + "?mode=ro"
source = sqlite3.connect(source_uri, uri=True, timeout=30)
target = sqlite3.connect(str(target_path), timeout=30)
try:
    source.backup(target)
    target.commit()
    result = target.execute("PRAGMA quick_check").fetchone()[0]
    if result != "ok":
        raise SystemExit(f"backup quick_check failed: {result}")
    if list(target.execute("PRAGMA foreign_key_check")):
        raise SystemExit("backup foreign_key_check failed")
finally:
    target.close()
    source.close()
PY

chmod 0600 "$TEMP"
mv -- "$TEMP" "$FINAL"
sha256sum "$FINAL" >"$CHECKSUM_TEMP"
chmod 0600 "$CHECKSUM_TEMP"
mv -- "$CHECKSUM_TEMP" "$FINAL.sha256"
"$DB_VERIFY" "$FINAL"

mapfile -t BACKUPS < <(find "$BACKUP_DIR" -maxdepth 1 -type f -name 'users-*.sqlite3' -printf '%T@ %p\n' | sort -rn | cut -d' ' -f2-)
NOW=$(date +%s)
for ((INDEX = KEEP_MIN; INDEX < ${#BACKUPS[@]}; INDEX++)); do
  CANDIDATE=${BACKUPS[$INDEX]}
  NAME=$(basename -- "$CANDIDATE")
  [[ "$NAME" =~ ^users-[0-9]{8}T[0-9]{6}Z\.sqlite3$ ]] || continue
  MODIFIED=$(stat -c %Y -- "$CANDIDATE")
  if (( NOW - MODIFIED > KEEP_DAYS * 86400 )); then
    unlink -- "$CANDIDATE"
    [[ ! -f "$CANDIDATE.sha256" ]] || unlink -- "$CANDIDATE.sha256"
  fi
done

echo "[backup] created and verified: $FINAL"
