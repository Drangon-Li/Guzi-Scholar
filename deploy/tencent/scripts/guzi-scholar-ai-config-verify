#!/usr/bin/env bash
set -Eeuo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: guzi-scholar-ai-config-verify /home/guzi/config/guzi-scholar/ai.tokens.json" >&2
  exit 64
fi

TOKENS_PATH=$1
if [[ "$TOKENS_PATH" != /home/guzi/config/guzi-scholar/ai.tokens.json || ! -f "$TOKENS_PATH" || -L "$TOKENS_PATH" ]]; then
  echo "[verify-ai] expected a regular non-symlink server token file at $TOKENS_PATH" >&2
  exit 66
fi

python3 - "$TOKENS_PATH" <<'PY'
import json
import grp
import pathlib
import stat
import sys
from urllib.parse import urlsplit

path = pathlib.Path(sys.argv[1])
metadata = path.stat()
mode = stat.S_IMODE(metadata.st_mode)
service_gid = grp.getgrnam("guzi-account").gr_gid
if metadata.st_uid != 0 or metadata.st_gid != service_gid or mode != 0o640:
    raise SystemExit(
        "AI token file must be root-owned, service-group readable, and mode 0640"
    )
if metadata.st_size < 2 or metadata.st_size > 64 * 1024:
    raise SystemExit("AI token file size is invalid")
try:
    payload = json.loads(path.read_text(encoding="utf-8"))
except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
    raise SystemExit("AI token file is not valid JSON") from exc
if not isinstance(payload, dict):
    raise SystemExit("AI token file root must be an object")
for service in ("translation", "chat"):
    profile = payload.get(service)
    if not isinstance(profile, dict):
        raise SystemExit(f"missing AI profile: {service}")
    base_url = str(profile.get("base_url", "")).strip().rstrip("/")
    parsed = urlsplit(base_url)
    if parsed.scheme != "https" or not parsed.hostname or parsed.username or parsed.password:
        raise SystemExit(f"{service} base_url must be a credential-free HTTPS URL")
    if not str(profile.get("api_key", "")).strip():
        raise SystemExit(f"{service} api_key is empty")
    if not str(profile.get("model", "")).strip():
        raise SystemExit(f"{service} model is empty")
print("[verify-ai] translation and chat profiles are configured; secret values were not printed")
PY
