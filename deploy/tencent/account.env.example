# Operator-only environment file installed as root:root 0600.
#
# Invitation codes are created with user_service.py create-invite and stored
# hashed in SQLite. Never place a real invitation code or an AI provider token
# in this file or in the repository.

# Email verification is a release requirement. The service refuses to start
# when email is disabled or either secret below is missing. Provision the real
# values only in /home/guzi/config/guzi-scholar/account.env on the server (root:root 0600).
MY_SCHOLAR_EMAIL_ENABLED=1
MY_SCHOLAR_REQUIRE_EMAIL_AUTH=1
MY_SCHOLAR_SMTP_HOST=smtp.163.com
MY_SCHOLAR_SMTP_PORT=465
MY_SCHOLAR_SMTP_SECURITY=ssl
MY_SCHOLAR_SMTP_USERNAME=guzilab_notify@163.com
MY_SCHOLAR_SMTP_PASSWORD=
MY_SCHOLAR_SMTP_FROM=guzilab_notify@163.com
MY_SCHOLAR_SMTP_FROM_NAME=谷子学术
MY_SCHOLAR_SMTP_REPLY_TO=guzilab@163.com

# Use an independent high-entropy secret for hashing email codes. It must not
# equal the SMTP authorization password and must never be committed.
MY_SCHOLAR_EMAIL_CODE_SECRET=
