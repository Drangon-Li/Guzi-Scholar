[Unit]
Description=Create and verify a consistent Guzi Scholar account database backup
After=local-fs.target
ConditionPathExists=/home/guzi/data/guzi-scholar/account/users.db

[Service]
Type=oneshot
User=guzi-account
Group=guzi-account
UMask=0077
RuntimeDirectory=guzi-scholar-account-backup
RuntimeDirectoryMode=0700
ExecStart=/home/guzi/services/guzi-scholar/sbin/guzi-scholar-account-backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/home/guzi/services/guzi-scholar/sbin
BindPaths=/home/guzi/backups/guzi-scholar/account /home/guzi/data/guzi-scholar/account
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
